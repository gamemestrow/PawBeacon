# Optional Supabase configuration.
# PawBeacon runs out-of-the-box in zero-key MVP mode without these values.
# Provide both keys to enable live PostgreSQL search and Supabase Realtime updates.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# GEMINI_API_KEY: Server-side environment variable if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
